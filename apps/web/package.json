{
  "name": "@evocut/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EvoCut mobile web app: the coarse pass.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
