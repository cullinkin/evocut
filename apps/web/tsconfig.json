{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    "paths": {
      "@evocut/edl": ["../../packages/edl/src/index.ts"],
      "@evocut/renderer": ["../../packages/renderer/src/index.ts"],
      "@evocut/agent": ["../../packages/agent/src/index.ts"],
      "@evocut/store": ["../../packages/store/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}
